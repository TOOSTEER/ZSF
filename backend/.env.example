# Пример переменных окружения для локальной разработки.
# НЕ используйте эти значения в продакшене!
#
# Для локального запуска скопируйте этот файл в .env:
#   cp .env.example .env
# и подставьте свои значения.

PORT=8080

# Для локальной разработки с Postgres на том же компьютере:
DATABASE_URL=postgres://postgres:123@localhost:5432/questdb?sslmode=disable&client_encoding=UTF8

# Секрет для подписи JWT. Сгенерируйте свой:
#   openssl rand -hex 32
JWT_SECRET=change_me_in_production

# Срок жизни токена в часах
JWT_EXPIRY_HOURS=24

# С какого адреса открывается фронтенд (для CORS)
CORS_ORIGIN=http://localhost:5500